CREATE TABLE files (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    filename TEXT NOT NULL,          -- e.g., "taxes_2026.pdf"
    parent_folder TEXT NOT NULL,     -- e.g., "/documents/financials/"
    full_path TEXT UNIQUE NOT NULL,  -- e.g., "/documents/financials/taxes_2026.pdf"
    size_bytes INTEGER,              -- e.g., 1500000
    created_at INTEGER,              -- e.g., 1714470000
    is_deleted BOOLEAN DEFAULT 0     -- For the UI's "Recycle Bin" feature
);




