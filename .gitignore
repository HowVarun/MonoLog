# This is the gitignore for Secure-Vault
# Ignore the Python Virtual Environment
venv/

# Ignore Private Security Keys (CRITICAL)
Putty_keys/

# Ignore Large Scaffold/Data files
Vaults/
*.scaf

# Ignore Database files (Optional, but usually a good idea)
*.db

# Ignore Guidebooks
Guidebooks/

#Ignore dev module for pqc
dev/


# Ignore Python Cache
__pycache__/
*.pyc